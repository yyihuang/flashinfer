"""Import sealed source-only Generated indexed-state KDA programs.

The two inputs are public CUDA-mode generated-program archives, one for each
Blackwell target.  This tool verifies every consumed artifact reference,
rejects binaries and private provenance, gives every installed implementation
source a ``generated_`` basename, and emits a content-addressed source catalog.
"""

from __future__ import annotations

import argparse
import ast
from contextlib import ExitStack
import hashlib
import json
import os
from pathlib import Path, PurePosixPath
import re
import shutil
import tarfile
import tempfile
from typing import Mapping


CATALOG_KIND = "flashinfer.generated_kda_indexed_prefill.source_catalog"
CATALOG_SCHEMA_VERSION = 2
IMPORT_RECEIPT_KIND = "flashinfer.generated_kda_indexed_prefill.import_receipt"
EXPECTED_MODULE_COUNT = 18
EXPECTED_ROUTE_COUNT = 48
TARGETS = {
    "sm100a": "sm_100a",
    "sm103a": "sm_103a",
}
_SHA256 = re.compile(r"[0-9a-f]{64}\Z")
_C_IDENTIFIER = re.compile(r"[A-Za-z_][A-Za-z0-9_]*\Z")
_SAFE_TOKEN = re.compile(r"[A-Za-z0-9][A-Za-z0-9_.:+-]*\Z")
_FORBIDDEN_BUILD_PROVENANCE = (
    b"ssh://",
    b"file://",
    b"/home/",
    b"/data/",
    b"/tmp/",
)


class ImportError(ValueError):
    """The source export is incomplete, inconsistent, or unsafe to import."""


def _canonical_bytes(value: object) -> bytes:
    return json.dumps(
        value,
        allow_nan=False,
        ensure_ascii=False,
        sort_keys=True,
        separators=(",", ":"),
    ).encode()


def _sha256(payload: bytes) -> str:
    return hashlib.sha256(payload).hexdigest()


def _require(condition: bool, message: str) -> None:
    if not condition:
        raise ImportError(message)


def _object(value: object, label: str) -> Mapping[str, object]:
    _require(isinstance(value, Mapping), f"{label} must be an object")
    assert isinstance(value, Mapping)
    return value


def _safe_relative(value: object, label: str) -> PurePosixPath:
    _require(isinstance(value, str) and bool(value), f"{label} must be a path")
    assert isinstance(value, str)
    path = PurePosixPath(value)
    _require(
        not path.is_absolute()
        and path.as_posix() == value
        and ".." not in path.parts
        and "." not in path.parts,
        f"{label} must be a normalized relative path",
    )
    return path


def _identifier(value: object, label: str) -> str:
    _require(
        isinstance(value, str) and _C_IDENTIFIER.fullmatch(value) is not None,
        f"{label} must be a C identifier",
    )
    assert isinstance(value, str)
    return value


def _safe_token(value: object, label: str) -> str:
    _require(
        isinstance(value, str)
        and _SAFE_TOKEN.fullmatch(value) is not None
        and ".." not in value,
        f"{label} must be a path-free token",
    )
    assert isinstance(value, str)
    return value


def _assert_public(payload: bytes, label: str) -> None:
    lowered = payload.lower()
    for forbidden in _FORBIDDEN_BUILD_PROVENANCE:
        _require(forbidden not in lowered, f"{label} contains private provenance")


def _full_identity(value: object, label: str) -> str:
    _require(
        isinstance(value, str)
        and value.startswith("sha256:")
        and _SHA256.fullmatch(value.removeprefix("sha256:")) is not None,
        f"{label} is invalid",
    )
    assert isinstance(value, str)
    return value


def _artifact_reference(
    value: object,
    *,
    label: str,
    expected_kind: str,
) -> Mapping[str, object]:
    reference = _object(value, label)
    _require(
        set(reference) == {"artifact_id", "kind", "path", "sha256", "size_bytes"},
        f"{label} fields differ",
    )
    _require(reference.get("kind") == expected_kind, f"{label} kind differs")
    _safe_token(reference.get("artifact_id"), f"{label}.artifact_id")
    digest = reference.get("sha256")
    size = reference.get("size_bytes")
    _require(
        isinstance(digest, str)
        and _SHA256.fullmatch(digest) is not None,
        f"{label} identity is invalid",
    )
    _require(
        isinstance(size, int) and not isinstance(size, bool) and size >= 0,
        f"{label} size is invalid",
    )
    _safe_relative(reference.get("path"), f"{label}.path")
    return reference


def _build_recipe_contract(
    payload: bytes,
    *,
    target: str,
) -> tuple[str, tuple[Mapping[str, object], ...]]:
    try:
        module = ast.parse(payload.decode("utf-8"), filename="generated_kda_build_cuda.py")
    except (UnicodeDecodeError, SyntaxError) as error:
        raise ImportError(f"{target} build recipe is not valid UTF-8 Python") from error
    assignments: dict[str, ast.expr] = {}
    for node in module.body:
        if (
            isinstance(node, ast.Assign)
            and len(node.targets) == 1
            and isinstance(node.targets[0], ast.Name)
            and node.targets[0].id in {"EXPECTED_TOOLCHAIN_IDENTITY", "UNITS"}
        ):
            _require(
                node.targets[0].id not in assignments,
                f"{target} build recipe identity is duplicated",
            )
            assignments[node.targets[0].id] = node.value
    _require(
        set(assignments) == {"EXPECTED_TOOLCHAIN_IDENTITY", "UNITS"},
        f"{target} build recipe identity is unresolved",
    )
    try:
        toolchain_identity = ast.literal_eval(assignments["EXPECTED_TOOLCHAIN_IDENTITY"])
    except (ValueError, TypeError) as error:
        raise ImportError(f"{target} toolchain identity is not literal") from error
    toolchain_identity = _full_identity(
        toolchain_identity,
        f"{target} toolchain identity",
    )
    units_expression = assignments["UNITS"]
    _require(
        isinstance(units_expression, ast.Call)
        and isinstance(units_expression.func, ast.Attribute)
        and isinstance(units_expression.func.value, ast.Name)
        and units_expression.func.value.id == "json"
        and units_expression.func.attr == "loads"
        and len(units_expression.args) == 1
        and not units_expression.keywords,
        f"{target} build recipe units are not a literal JSON closure",
    )
    try:
        units_json = ast.literal_eval(units_expression.args[0])
        units = json.loads(units_json)
    except (ValueError, TypeError, json.JSONDecodeError) as error:
        raise ImportError(f"{target} build recipe units are invalid") from error
    _require(
        isinstance(units, list) and len(units) == EXPECTED_MODULE_COUNT,
        f"{target} build recipe module denominator differs",
    )
    normalized: list[Mapping[str, object]] = []
    expected_fields = {
        "id",
        "source",
        "source_sha256",
        "output",
        "architecture",
        "compile_options",
        "expected_cubin_sha256",
        "expected_cubin_size_bytes",
    }
    for index, raw_unit in enumerate(units):
        unit = _object(raw_unit, f"{target} build recipe unit {index}")
        _require(
            set(unit) == expected_fields,
            f"{target} build recipe unit {index} fields differ",
        )
        _safe_token(unit.get("id"), f"{target} build recipe unit {index}.id")
        _require(
            unit.get("architecture") == TARGETS[target],
            f"{target} build recipe unit {index} identity differs",
        )
        _safe_relative(unit.get("source"), f"{target} build recipe unit {index}.source")
        _safe_relative(unit.get("output"), f"{target} build recipe unit {index}.output")
        _require(
            isinstance(unit.get("source_sha256"), str)
            and _SHA256.fullmatch(str(unit.get("source_sha256"))) is not None
            and isinstance(unit.get("expected_cubin_sha256"), str)
            and _SHA256.fullmatch(str(unit.get("expected_cubin_sha256"))) is not None,
            f"{target} build recipe unit {index} digest is invalid",
        )
        _require(
            isinstance(unit.get("expected_cubin_size_bytes"), int)
            and not isinstance(unit.get("expected_cubin_size_bytes"), bool)
            and int(unit["expected_cubin_size_bytes"]) > 0,
            f"{target} build recipe unit {index} size is invalid",
        )
        options = unit.get("compile_options")
        _require(
            isinstance(options, list)
            and all(isinstance(option, str) and option for option in options),
            f"{target} build recipe unit {index} compile options are invalid",
        )
        normalized.append(unit)
    unit_ids = [str(unit["id"]) for unit in normalized]
    _require(
        len(unit_ids) == len(set(unit_ids)),
        f"{target} build recipe contains duplicate unit ids",
    )
    return toolchain_identity, tuple(normalized)


def _validate_build_output_unit_closure(
    build_outputs: tuple[Mapping[str, object], ...] | list[Mapping[str, object]],
    recipe_units_by_id: Mapping[str, Mapping[str, object]],
    *,
    target: str,
) -> None:
    output_ids = [
        _safe_token(
            output.get("artifact_id"),
            f"{target} build output {index}.artifact_id",
        )
        for index, output in enumerate(build_outputs)
    ]
    _require(
        len(output_ids) == len(set(output_ids))
        and set(output_ids) == set(recipe_units_by_id),
        f"{target} build outputs and recipe units are not a one-to-one closure",
    )


def _dispatcher_module_ids(payload: bytes) -> tuple[str, ...]:
    try:
        module = ast.parse(payload.decode("utf-8"), filename="generated_kda_dispatcher.py")
    except (UnicodeDecodeError, SyntaxError) as error:
        raise ImportError("generated dispatcher is not valid UTF-8 Python") from error
    assignments = [
        node
        for node in module.body
        if isinstance(node, ast.Assign)
        and len(node.targets) == 1
        and isinstance(node.targets[0], ast.Name)
        and node.targets[0].id == "FLASHINFER_MODULE_IDS"
    ]
    _require(len(assignments) == 1, "generated dispatcher module inventory is unresolved")
    try:
        value = ast.literal_eval(assignments[0].value)
    except (ValueError, TypeError) as error:
        raise ImportError("generated dispatcher module inventory is not literal") from error
    _require(
        isinstance(value, tuple)
        and len(value) == EXPECTED_MODULE_COUNT
        and all(isinstance(item, str) and item for item in value),
        "generated dispatcher module inventory differs",
    )
    return value


class _Archive:
    def __init__(self, path: Path) -> None:
        self.path = path.resolve(strict=True)
        _require(self.path.is_file(), f"archive is not a regular file: {self.path}")
        self.payload_sha256 = _sha256(self.path.read_bytes())
        try:
            self.tar = tarfile.open(self.path, mode="r:*")  # noqa: SIM115
        except tarfile.TarError as error:
            raise ImportError(f"cannot read archive {self.path}: {error}") from error
        self.members: dict[str, tarfile.TarInfo] = {}
        try:
            for member in self.tar.getmembers():
                normalized = member.name.removeprefix("./")
                if normalized in ("", "."):
                    continue
                _safe_relative(normalized.rstrip("/"), "archive member")
                _require(
                    normalized not in self.members,
                    f"duplicate archive member: {normalized}",
                )
                _require(
                    not member.issym() and not member.islnk(),
                    f"archive links are forbidden: {normalized}",
                )
                self.members[normalized] = member
        except BaseException:
            self.tar.close()
            raise

    def __enter__(self) -> _Archive:
        return self

    def __exit__(self, *_exc_info: object) -> None:
        self.close()

    def close(self) -> None:
        self.tar.close()

    def read(self, path: PurePosixPath | str, *, label: str) -> bytes:
        normalized = _safe_relative(str(path), label).as_posix()
        member = self.members.get(normalized)
        _require(member is not None and member.isfile(), f"{label} is absent: {normalized}")
        assert member is not None
        extracted = self.tar.extractfile(member)
        _require(extracted is not None, f"cannot read {label}: {normalized}")
        assert extracted is not None
        payload = extracted.read()
        _require(len(payload) == member.size, f"{label} size changed while reading")
        return payload

    def read_reference(
        self,
        value: object,
        *,
        label: str,
        expected_kind: str,
    ) -> tuple[PurePosixPath, bytes]:
        reference = _artifact_reference(
            value,
            label=label,
            expected_kind=expected_kind,
        )
        digest = reference["sha256"]
        size = reference["size_bytes"]
        assert isinstance(digest, str)
        assert isinstance(size, int)
        path = _safe_relative(reference.get("path"), f"{label}.path")
        payload = self.read(path, label=label)
        _require(
            len(payload) == size and _sha256(payload) == digest,
            f"{label} content identity differs",
        )
        _assert_public(payload, label)
        return path, payload


def _write(root: Path, relative: PurePosixPath, payload: bytes) -> dict[str, object]:
    path = root.joinpath(*relative.parts)
    path.parent.mkdir(parents=True, exist_ok=True)
    _require(not path.exists() and not path.is_symlink(), f"duplicate output: {relative}")
    path.write_bytes(payload)
    return {
        "path": relative.as_posix(),
        "sha256": _sha256(payload),
        "size_bytes": len(payload),
    }


def _load_fragment(archive: _Archive, target: str) -> tuple[Mapping[str, object], bytes]:
    relative = PurePosixPath("generated_program") / target / "cuda" / "fragment.json"
    payload = archive.read(relative, label=f"{target} fragment")
    _assert_public(payload, f"{target} fragment")
    try:
        fragment = json.loads(payload)
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise ImportError(f"{target} fragment is invalid JSON") from error
    fragment = _object(fragment, f"{target} fragment")
    _require(
        fragment.get("kind") == "flashinfer.generated_program_pack.fragment"
        and fragment.get("schema_version") == 1
        and fragment.get("mode") == "cuda"
        and fragment.get("target") == target
        and fragment.get("architecture") == TARGETS[target],
        f"{target} fragment identity differs",
    )
    routes = fragment.get("routes")
    modules = fragment.get("modules")
    build = _object(fragment.get("build"), f"{target} build")
    _require(
        isinstance(routes, list) and len(routes) == EXPECTED_ROUTE_COUNT,
        f"{target} route denominator differs",
    )
    _require(
        isinstance(modules, list) and len(modules) == EXPECTED_MODULE_COUNT,
        f"{target} module denominator differs",
    )
    _require(
        set(build) == {"kind", "recipe", "outputs"}
        and build.get("kind") == "nvrtc",
        f"{target} is not a complete CUDA source export",
    )
    outputs = build.get("outputs")
    _require(
        isinstance(outputs, list) and len(outputs) == EXPECTED_MODULE_COUNT,
        f"{target} build output denominator differs",
    )
    return fragment, payload


def _import_target(
    archive: _Archive,
    *,
    target: str,
    staging: Path,
) -> dict[str, object]:
    fragment, fragment_payload = _load_fragment(archive, target)
    build = _object(fragment["build"], f"{target} build")
    recipe_reference = _artifact_reference(
        build.get("recipe"),
        label=f"{target} build recipe",
        expected_kind="build_recipe",
    )
    _recipe_input, recipe = archive.read_reference(
        recipe_reference,
        label=f"{target} build recipe",
        expected_kind="build_recipe",
    )
    toolchain_identity, recipe_units = _build_recipe_contract(
        recipe,
        target=target,
    )
    recipe_units_by_id = {str(unit["id"]): unit for unit in recipe_units}
    build_outputs = tuple(
        _artifact_reference(
            value,
            label=f"{target} build output {index}",
            expected_kind="cubin",
        )
        for index, value in enumerate(build["outputs"])
    )
    _validate_build_output_unit_closure(
        build_outputs,
        recipe_units_by_id,
        target=target,
    )
    dispatcher_ref = fragment.get("dispatcher")
    _dispatcher_input, dispatcher = archive.read_reference(
        dispatcher_ref,
        label=f"{target} dispatcher",
        expected_kind="python_source",
    )
    module_ids = _dispatcher_module_ids(dispatcher)

    generated_root = PurePosixPath("generated") / target
    recipe_record = _write(
        staging,
        generated_root / "generated_kda_build_cuda.py",
        recipe,
    )
    dispatcher_output = generated_root / "generated_kda_dispatcher.py"
    dispatcher_record = _write(staging, dispatcher_output, dispatcher)
    modules: list[dict[str, object]] = []
    observed_ids: list[str] = []
    for index, raw_module in enumerate(fragment["modules"]):
        module = _object(raw_module, f"{target} module {index}")
        _require(
            set(module)
            == {
                "id",
                "module_ident",
                "entry_point",
                "kernel_name",
                "cuda_source",
                "host_source",
                "shared_library",
                "cubin",
                "build_recipe",
                "build_output",
                "build_receipt",
            },
            f"{target} module {index} fields differ",
        )
        module_id = _safe_token(module.get("id"), f"{target} module {index}.id")
        module_ident = _identifier(
            module.get("module_ident"), f"{target} module {index}.module_ident"
        )
        entry_point = _identifier(
            module.get("entry_point"), f"{target} module {index}.entry_point"
        )
        kernel_name = _identifier(
            module.get("kernel_name"), f"{target} module {index}.kernel_name"
        )
        observed_ids.append(module_id)
        cuda_reference = _artifact_reference(
            module.get("cuda_source"),
            label=f"{target} module {index} CUDA source",
            expected_kind="cuda_source",
        )
        _cuda_input, cuda_source = archive.read_reference(
            cuda_reference,
            label=f"{target} module {index} CUDA source",
            expected_kind="cuda_source",
        )
        host_reference = _artifact_reference(
            module.get("host_source"),
            label=f"{target} module {index} host source",
            expected_kind="host_source",
        )
        _host_input, host_source = archive.read_reference(
            host_reference,
            label=f"{target} module {index} host source",
            expected_kind="host_source",
        )
        receipt = _object(module.get("build_receipt"), f"{target} module {index} build receipt")
        _require(
            set(receipt)
            == {
                "compile_options",
                "cooperative",
                "cubin_sha256",
                "cubin_size_bytes",
                "cuda_source_sha256",
                "cuda_source_size_bytes",
                "host_source_sha256",
                "host_source_size_bytes",
                "tma_abi",
                "use_pdl",
            },
            f"{target} module {index} build receipt fields differ",
        )
        compile_options = receipt.get("compile_options")
        _require(
            isinstance(compile_options, list)
            and all(isinstance(option, str) and option for option in compile_options),
            f"{target} module {index} compile options are invalid",
        )
        _require(
            receipt.get("cuda_source_sha256") == _sha256(cuda_source)
            and receipt.get("cuda_source_size_bytes") == len(cuda_source)
            and receipt.get("host_source_sha256") == _sha256(host_source)
            and receipt.get("host_source_size_bytes") == len(host_source),
            f"{target} module {index} source receipt differs",
        )
        cubin_sha256 = receipt.get("cubin_sha256")
        cubin_size = receipt.get("cubin_size_bytes")
        _require(
            isinstance(cubin_sha256, str)
            and _SHA256.fullmatch(cubin_sha256)
            and isinstance(cubin_size, int)
            and cubin_size > 0,
            f"{target} module {index} cubin receipt is invalid",
        )
        output_reference = build_outputs[index]
        _require(
            module.get("build_recipe") == recipe_reference
            and module.get("build_output") == output_reference
            and module.get("cubin") == output_reference,
            f"{target} module {index} build closure differs",
        )
        unit = recipe_units_by_id.get(str(output_reference["artifact_id"]))
        _require(
            unit is not None,
            f"{target} module {index} build unit is unavailable",
        )
        assert unit is not None
        _require(
            unit["id"] == output_reference["artifact_id"]
            and unit["source"] == cuda_reference["path"]
            and unit["source_sha256"] == cuda_reference["sha256"]
            and unit["output"] == output_reference["path"]
            and unit["architecture"] == TARGETS[target]
            and unit["compile_options"] == compile_options
            and unit["expected_cubin_sha256"] == cubin_sha256
            and unit["expected_cubin_size_bytes"] == cubin_size
            and output_reference["sha256"] == cubin_sha256
            and output_reference["size_bytes"] == cubin_size,
            f"{target} module {index} differs from its build recipe",
        )
        module_root = generated_root / f"generated_kda_module_{index:03d}"
        cuda_record = _write(
            staging,
            module_root / f"generated_kda_module_{index:03d}_kernel.cu",
            cuda_source,
        )
        host_record = _write(
            staging,
            module_root / f"generated_kda_module_{index:03d}_host.cpp",
            host_source,
        )
        modules.append(
            {
                "id": module_id,
                "module_ident": module_ident,
                "entry_point": entry_point,
                "kernel_name": kernel_name,
                "compile_options": compile_options,
                "cooperative": receipt.get("cooperative"),
                "tma_abi": receipt.get("tma_abi"),
                "use_pdl": receipt.get("use_pdl"),
                "cuda_source": cuda_record,
                "host_source": host_record,
                "expected_cubin": {
                    "sha256": cubin_sha256,
                    "size_bytes": cubin_size,
                },
            }
        )
    _require(tuple(observed_ids) == module_ids, f"{target} dispatcher/module order differs")
    _require(len(observed_ids) == len(set(observed_ids)), f"{target} module ids are not unique")
    return {
        "target": target,
        "architecture": TARGETS[target],
        "input_archive_sha256": archive.payload_sha256,
        "input_fragment_sha256": _sha256(fragment_payload),
        "route_denominator_sha256": fragment.get("route_denominator_sha256"),
        "dispatcher_seed_identity": fragment.get("dispatcher_seed_identity"),
        "toolchain_identity": toolchain_identity,
        "contract": fragment.get("contract"),
        "build_recipe": recipe_record,
        "dispatcher": dispatcher_record,
        "modules": modules,
    }


def _manifest(root: Path) -> list[dict[str, object]]:
    records = []
    for path in sorted(root.rglob("*")):
        if path.is_file():
            relative = path.relative_to(root).as_posix()
            payload = path.read_bytes()
            records.append(
                {"path": relative, "sha256": _sha256(payload), "size_bytes": len(payload)}
            )
    return records


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--sm100a-archive", required=True, type=Path)
    parser.add_argument("--sm103a-archive", required=True, type=Path)
    parser.add_argument("--repo", required=True, type=Path)
    args = parser.parse_args()

    repository = args.repo.resolve(strict=True)
    _require((repository / ".git").exists(), f"not a Git worktree: {repository}")
    destination = repository / "csrc" / "generated_kda_indexed_prefill"
    _require(
        not destination.exists() and not destination.is_symlink(),
        f"destination already exists: {destination}",
    )
    destination.parent.mkdir(parents=True, exist_ok=True)
    staging = Path(tempfile.mkdtemp(prefix=".generated_kda_indexed_prefill-", dir=destination.parent))
    try:
        with ExitStack() as stack:
            archives = {
                "sm100a": stack.enter_context(_Archive(args.sm100a_archive)),
                "sm103a": stack.enter_context(_Archive(args.sm103a_archive)),
            }
            targets = [
                _import_target(archives[target], target=target, staging=staging)
                for target in TARGETS
            ]
            catalog = {
                "kind": CATALOG_KIND,
                "schema_version": CATALOG_SCHEMA_VERSION,
                "targets": targets,
            }
            catalog_payload = _canonical_bytes(catalog) + b"\n"
            _assert_public(catalog_payload, "source catalog")
            _write(
                staging,
                PurePosixPath("generated_kda_source_catalog.json"),
                catalog_payload,
            )
            manifest = _manifest(staging)
            receipt = {
                "kind": IMPORT_RECEIPT_KIND,
                "schema_version": 1,
                "catalog_sha256": _sha256(catalog_payload),
                "inputs": [
                    {
                        "target": target,
                        "archive_sha256": archives[target].payload_sha256,
                    }
                    for target in TARGETS
                ],
                "outputs": manifest,
                "passed": True,
            }
            receipt_payload = _canonical_bytes(receipt) + b"\n"
            _assert_public(receipt_payload, "import receipt")
            _write(
                staging,
                PurePosixPath("generated_kda_import_receipt.json"),
                receipt_payload,
            )
            os.replace(staging, destination)
    except BaseException:
        shutil.rmtree(staging, ignore_errors=True)
        raise

    print(
        json.dumps(
            {
                "destination": str(destination),
                "targets": list(TARGETS),
                "modules_per_target": EXPECTED_MODULE_COUNT,
                "binary_files": 0,
            },
            sort_keys=True,
        )
    )


if __name__ == "__main__":
    main()
